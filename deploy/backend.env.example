SERVER_PORT=9090

# Point this to the connector host that can actually reach TallyPrime.
# Examples:
# INGEST_BASE_URL=http://192.168.1.25:8082
# INGEST_BASE_URL=http://connector.internal.ridsys:8082
INGEST_BASE_URL=http://192.168.1.25:8082

INGEST_AGENT_KEY=change-me-strong-agent-key
AUTH_TOKEN_SECRET=change-me-very-strong-token-secret
AUTH_TOKEN_TTL_SEC=3600
AUTH_ACCEPT_STATIC_AGENT_KEY=false
AUTH_COOKIE_SECURE_MODE=true
CONNECTOR_ALLOW_DIRECT_BASE_URL_OVERRIDE=false

SPRING_DATASOURCE_PASSWORD=change-me-db-password

AUTH_BOOTSTRAP_PASSWORD=change-me-admin-password

TALLY_SYNC_TARGET_URL=http://127.0.0.1:9000
TALLY_CACHE_SYNC_ENABLED=true
TALLY_CACHE_SYNC_INTERVAL_MS=10000
TALLY_CACHE_SYNC_STALE_AFTER_MS=300000
TALLY_CACHE_SYNC_COMPANY=
TALLY_WRITE_QUEUE_ENABLED=true
TALLY_WRITE_QUEUE_AUTO_PROCESS_APPROVED=true
TALLY_WRITE_QUEUE_RETRY_INTERVAL_MS=10000
TALLY_WRITE_QUEUE_BATCH_SIZE=10
TALLY_WRITE_QUEUE_MAX_ATTEMPTS=-1

LOGGING_LEVEL_ROOT=INFO
