TALLY_BASE_URL=http://127.0.0.1:9000
COMPANY=
BRANCH=
CONNECTOR_ID=
AGENT_KEY=local-dev-key
AUTH_CLIENT_ID=admin
AUTH_CLIENT_SECRET=admin@123
AUTH_TOKEN_SECRET=local-dev-key
AUTH_TOKEN_TTL_SEC=3600
AUTH_ACCEPT_STATIC_KEY=true

LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8082

GST_SERVICE_BASE_URL=http://127.0.0.1:8081/api/gst/mi
GST_SERVICE_TIMEOUT_SEC=60
GST_REQUEST_MAX_RETRIES=1
GST_REQUEST_BACKOFF_SEC=0.5

CONNECTOR_ANNOUNCE_ENABLED=true
CONNECTOR_ANNOUNCE_INTERVAL_SEC=60
SYNC_ENABLED=false
SYNC_DIRECTION=both
SYNC_INTERVAL_SEC=60
SERVER_MODE=connector

# Set this to your backend URL if this Windows connector should auto-register there.
SERVER_BASE_URL=http://192.168.1.212:9090
SERVER_AGENT_KEY=prod-agent-key

# Experimental company/security routes.
EXPERIMENTAL_TALLY_COMPANY_OPEN_ENABLED=true
EXPERIMENTAL_TALLY_COMPANY_CREATE_ENABLED=true
EXPERIMENTAL_TALLY_SECURITY_ROLES_ENABLED=true

APP_ENV=development
STRICT_STARTUP_VALIDATION=false
TALLY_REQUEST_MAX_RETRIES=2
TALLY_REQUEST_BACKOFF_SEC=0.5
TALLY_XML_TRACE_ENABLED=false
TALLY_XML_TRACE_DIR=

# TDL-backed features.
TDL_INTEGRATION_ENABLED=true
TDL_PROFILE_NAME=local_connector_profile
TDL_PACKAGE_PATH=
TDL_MANIFEST_PATH=
TDL_REQUIRED_FEATURES=company_open,company_create,security_roles,price_levels,payroll_exports
